#include <iostream>
#include <stdio.h>
using namespace std;

class Student
{
protected:
    int roll;
    char name[25];

public:
    void getdata()
    {
        cout << "\nEnter Roll No. : ";
        cin >> roll;

        cout << "Enter Student Name : ";
        cin >> name;
    }

    void putdata()
    {
        cout << "\nStudent Marklist";
        cout << "\nRoll No. : " << roll;
        cout << "\nStudent Name : " << name << endl;
    }
};

class StudentExam : public Student
{
protected:
    int marks[6];

public:
    void accept_data()
    {
        getdata();

        for (int i = 0; i < 6; i++)
        {
            cout << "Enter Marks for Subject " << i + 1 << " : ";
            cin >> marks[i];
        }
    }

    void display_data()
    {
        putdata();

        for (int i = 0; i < 6; i++)
        {
            cout << "Marks of Subject " << i + 1 << " : "
                 << marks[i] << endl;
        }
    }
};

class StudentResult : public StudentExam
{
protected:
    float per;

public:
    void calculate()
    {
        int total = 0;

        for (int i = 0; i < 6; i++)
        {
            total = total + marks[i];
        }

        per = total / 6.0;

        cout << "Total Marks : " << total;
        cout << "\nTotal Percentage : " << per << "%";
    }
};

int main()
{
    int cnt;

    cout << "Enter No. of Students You Want : ";
    cin >> cnt;

    for (int i = 0; i < cnt; i++)
    {
        cout << "\n\n===== Student " << i + 1 << " =====";

        StudentResult str;

        str.accept_data();
        str.display_data();
        str.calculate();

        cout << "\n";
    }

    return 0;
}