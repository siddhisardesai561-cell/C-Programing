
#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main()
{
    string data;

    // Write data to the file
    ofstream fout("data.txt");

    cout << "Enter data to write into the file: ";
    getline(cin, data);

    fout << data;
    fout.close();

    cout << "\nData written successfully to the file.\n";

    // Read data from the file
    ifstream fin("data.txt");

    cout << "\nData read from the file:\n";

    string line;
    while (getline(fin, line))
    {
        cout << line << endl;
    }

    fin.close();

    return 0;
}
